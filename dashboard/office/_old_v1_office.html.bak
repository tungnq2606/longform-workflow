<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Studio Office</title>
<style>
:root{
  --bg:#e9e4da; --ink:#1d2329; --ink2:#47515b; --mute:#77818a; --card:rgba(255,255,255,.88); --line:rgba(29,35,41,.12);
  --claude:#d97757; --gemini:#3b7de9; --code:#6b7684; --owner:#2f9e6b; --warn:#d9822b; --bad:#d64545; --ok:#2f9e6b;
  --shadow:0 10px 30px rgba(20,24,28,.16);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){--bg:#171b20; --ink:#eef1f4; --ink2:#c3cad1; --mute:#8d97a1; --card:rgba(28,33,39,.9); --line:rgba(255,255,255,.1); --shadow:0 10px 30px rgba(0,0,0,.45)}
}
:root[data-theme="dark"]{--bg:#171b20; --ink:#eef1f4; --ink2:#c3cad1; --mute:#8d97a1; --card:rgba(28,33,39,.9); --line:rgba(255,255,255,.1); --shadow:0 10px 30px rgba(0,0,0,.45)}
*{box-sizing:border-box}
html,body{margin:0;height:100%;overflow:hidden;background:var(--bg);color:var(--ink);font:14px/1.45 "IBM Plex Sans",system-ui,-apple-system,sans-serif}
#app{position:fixed;inset:0}
#app canvas{display:block}
.hud{position:fixed;z-index:5;background:var(--card);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow)}
#top{top:14px;left:14px;right:14px;display:flex;align-items:center;gap:12px;padding:8px 12px;flex-wrap:wrap}
#top b{font-size:15px}
#top .sp{flex:1}
select,button,a.btn{font:inherit;color:var(--ink);background:transparent;border:1px solid var(--line);border-radius:9px;padding:6px 10px;cursor:pointer;text-decoration:none;white-space:nowrap}
button:hover,a.btn:hover{border-color:var(--ink2)}
button:active,a.btn:active{transform:translateY(1px)}
button.pri{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px;vertical-align:0}
#run{font-weight:600}
#panel{top:72px;right:14px;bottom:14px;width:360px;max-width:calc(100vw - 28px);padding:14px 16px;overflow:auto}
#panel h2{margin:0 0 2px;font-size:17px}
#panel h3{margin:14px 0 6px;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}
#panel .muted{color:var(--mute)}
#panel pre{white-space:pre-wrap;word-break:break-word;font:12px/1.4 "IBM Plex Mono",ui-monospace,monospace;background:rgba(127,127,127,.1);border-radius:8px;padding:8px;max-height:260px;overflow:auto;margin:6px 0 0}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.list{list-style:none;margin:0;padding:0}
.list li{display:flex;align-items:center;gap:8px;padding:6px 4px;border-top:1px solid var(--line);cursor:pointer}
.list li:hover{background:rgba(127,127,127,.08)}
.chip{font-size:11px;padding:1px 7px;border-radius:99px;border:1px solid var(--line);color:var(--ink2);white-space:nowrap}
.chip.running{border-color:var(--warn);color:var(--warn)}
.chip.done{border-color:var(--ok);color:var(--ok)}
.chip.error,.chip.stopped{border-color:var(--bad);color:var(--bad)}
#feed{left:14px;bottom:14px;width:340px;max-width:calc(100vw - 28px);padding:8px 12px;font-size:12px}
#feed div{display:flex;gap:6px;align-items:center;padding:2px 0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
#legend{left:14px;top:72px;padding:8px 12px;font-size:12px;color:var(--ink2)}
#legend span{margin-right:10px;white-space:nowrap}
/* labels drawn over the 3D scene */
.room-label{font-weight:700;font-size:13px;color:#2a2f35;background:rgba(255,255,255,.75);padding:2px 8px;border-radius:6px;pointer-events:none;white-space:nowrap}
.name{font-size:11px;color:#2a2f35;background:rgba(255,255,255,.82);padding:0 6px;border-radius:5px;pointer-events:none;white-space:nowrap}
.bubble{font-size:12px;max-width:220px;background:#fff;color:#1d2329;border:2px solid #1d2329;border-radius:10px;padding:3px 8px;pointer-events:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;box-shadow:0 4px 10px rgba(0,0,0,.15)}
.bubble.run{border-color:var(--warn)}
.bubble.done{border-color:var(--ok)}
.bubble.bad{border-color:var(--bad);color:var(--bad)}
.bubble .t{color:#77818a;margin-left:6px;font-variant-numeric:tabular-nums}
.folder{font-size:11px;font-weight:600;color:#1d2329;background:#ffe9a8;border:1.5px solid #1d2329;border-radius:5px;padding:0 5px;pointer-events:none;white-space:nowrap}
.folder.wait{background:#ffd2c2}
@media (max-width:760px){#legend,#feed{display:none}#panel{top:auto;height:46vh;left:14px;width:auto}}
@media (prefers-reduced-motion: reduce){*{transition:none!important}}
</style>
<script type="importmap">{"imports":{"three":"/vendor/three/three.module.min.js","three/addons/":"/vendor/three/addons/"}}</script>
</head>
<body>
<div id="app" aria-label="Văn phòng 3D: các phòng ban và nhân viên AI đang làm việc"></div>
<div id="top" class="hud">
  <b>Studio · Văn phòng</b>
  <label class="muted" for="ch">Kênh</label><select id="ch"></select>
  <span id="run" aria-live="polite"></span>
  <span class="sp"></span>
  <button id="home">Toàn cảnh</button>
  <button id="labels" aria-pressed="true">Ẩn tên</button>
  <a class="btn" href="/">Bảng điều khiển</a>
</div>
<div id="legend" class="hud">
  <span><i class="dot" style="background:var(--claude)"></i>Claude</span>
  <span><i class="dot" style="background:var(--gemini)"></i>Gemini</span>
  <span><i class="dot" style="background:var(--code)"></i>Máy (code)</span>
  <span><i class="dot" style="background:var(--owner)"></i>Bạn</span>
  <span>· Kéo để di chuyển, cuộn để phóng to, chuột phải để xoay</span>
</div>
<aside id="panel" class="hud" aria-live="polite"></aside>
<div id="feed" class="hud" aria-label="Việc gần đây"></div>

<script type="module">
import * as THREE from 'three';
import {OrbitControls} from 'three/addons/OrbitControls.js';
import {CSS2DRenderer, CSS2DObject} from 'three/addons/CSS2DRenderer.js';

const $ = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c]));
const fmt = t => Math.floor(t / 60) + ':' + String(Math.floor(t % 60)).padStart(2, '0');
const COLORS = {claude: 0xd97757, gemini: 0x3b7de9, code: 0x6b7684, owner: 0x2f9e6b};
const WHO = {claude: 'Claude', gemini: 'Gemini', code: 'Máy (code)', owner: 'Bạn'};

// ------------------------------------------------------------ the company: rooms = pipeline stages, staff = who does the work
const ROOMS = [
  {id: 'boss', name: 'Phòng của bạn', x: -21, z: 8, w: 12, d: 13, floor: 0xd8cbb3, tab: 'script'},
  {id: 'research', name: 'Phòng Nghiên cứu', x: -21, z: -8, w: 12, d: 13, floor: 0xc9d8c5, tab: 'script'},
  {id: 'script', name: 'Phòng Kịch bản', x: -7, z: -8, w: 12, d: 13, floor: 0xd9cfe3, tab: 'script'},
  {id: 'art', name: 'Phòng Mỹ thuật', x: 14, z: -8, w: 26, d: 13, floor: 0xe8d6c2, tab: 'shots'},
  {id: 'voice', name: 'Phòng Thu âm', x: -7, z: 8, w: 12, d: 13, floor: 0xc6d3df, tab: 'voice'},
  {id: 'edit', name: 'Phòng Dựng phim', x: 7, z: 8, w: 12, d: 13, floor: 0xd6d0c4, tab: 'preview'},
  {id: 'publish', name: 'Phòng Phát hành', x: 21, z: 8, w: 12, d: 13, floor: 0xe3d3d0, tab: 'upload'},
];
// actions come from the dashboard buttons (job.action); kind is the fallback
const STAFF = [
  {id: 'owner', name: 'Bạn', role: 'Giám đốc: duyệt, tạo ảnh key trên Flow, thu giọng', who: 'owner', room: 'boss', at: [-2, 1]},
  {id: 'assistant', name: 'Claude', role: 'Trợ lý: làm theo yêu cầu bạn gõ trong ô chat', who: 'claude', room: 'boss', at: [2.5, -1.5], actions: ['claude']},
  {id: 'researcher', name: 'Gemini', role: 'Nhà nghiên cứu: chủ đề, nguồn, đối thủ, gợi ý cụm từ', who: 'gemini', room: 'research', at: [-2.5, -2], actions: ['research_topic', 'competitors', 'suggest_phrases', 'gemini']},
  {id: 'scout', name: 'Máy đo', role: 'Đo nhu cầu và cạnh tranh trên YouTube (yt-dlp)', who: 'code', room: 'research', at: [2.5, 1.5], actions: ['scout']},
  {id: 'writer', name: 'Claude', role: 'Biên kịch: viết và sửa kịch bản, kiểm nguồn', who: 'claude', room: 'script', at: [-2.5, -2], actions: ['write_script', 'fix_script']},
  {id: 'viewer', name: 'Gemini', role: 'Khán giả thử: đọc kịch bản và góp ý', who: 'gemini', room: 'script', at: [2.5, 1.5], actions: ['simulate']},
  {id: 'director', name: 'Claude', role: 'Đạo diễn hình: chia cảnh, nhân vật, prompt', who: 'claude', room: 'art', at: [-10, -2.5], actions: ['make_shots', 'claude_shot']},
  {id: 'checker', name: 'Máy kiểm', role: 'Tạo và kiểm prompt theo style khóa', who: 'code', room: 'art', at: [-10, 2.5], actions: ['prompts', 'check_prompts']},
  {id: 'p1', name: 'Gemini', role: 'Họa sĩ 1: vẽ ảnh cảnh', who: 'gemini', room: 'art', at: [-4, -2.5], actions: ['generate', 'redo', 'redo_many'], painter: 1},
  {id: 'p2', name: 'Gemini', role: 'Họa sĩ 2: vẽ ảnh cảnh', who: 'gemini', room: 'art', at: [0.5, -2.5], actions: ['generate', 'redo', 'redo_many'], painter: 2},
  {id: 'p3', name: 'Gemini', role: 'Họa sĩ 3: vẽ ảnh cảnh', who: 'gemini', room: 'art', at: [5, -2.5], actions: ['generate', 'redo', 'redo_many'], painter: 3},
  {id: 'p4', name: 'Gemini', role: 'Họa sĩ 4: vẽ ảnh cảnh', who: 'gemini', room: 'art', at: [9.5, -2.5], actions: ['generate', 'redo', 'redo_many'], painter: 4},
  {id: 'reviewer', name: 'Gemini', role: 'Kiểm duyệt ảnh: so với cast sheet và prompt', who: 'gemini', room: 'art', at: [5, 3], actions: ['review']},
  {id: 'voicebot', name: 'Máy tách lời', role: 'Tạo text giọng đọc cho extension ElevenLabs', who: 'code', room: 'voice', at: [-2.5, -2], actions: ['voice_text']},
  {id: 'render', name: 'Máy dựng', role: 'Remotion: ghép ảnh, giọng, phụ đề thành video 1440p', who: 'code', room: 'edit', at: [0, -1.5], actions: ['render', 'studio']},
  {id: 'publisher', name: 'Claude', role: 'Biên tập đăng: tiêu đề, mô tả, tag', who: 'claude', room: 'publish', at: [-2.5, -2], actions: ['write_upload']},
  {id: 'marketer', name: 'Gemini', role: 'Thumbnail và nháp tiêu đề', who: 'gemini', room: 'publish', at: [2.5, 1.5], actions: ['titles', 'thumb']},
];
const ROOM_OF_STEP = {research: 'research', script: 'script', sim: 'script', shots: 'art', sheets: 'art', scenes: 'art', review: 'art', voice: 'voice', render: 'edit', upload: 'publish'};
const TAB_OF_STEP = {research: 'script', script: 'script', sim: 'script', shots: 'shots', sheets: 'shots', scenes: 'shots', review: 'shots', voice: 'voice', render: 'preview', upload: 'upload'};
const roomById = Object.fromEntries(ROOMS.map(r => [r.id, r]));

// ------------------------------------------------------------ scene
const app = $('#app');
const renderer = new THREE.WebGLRenderer({antialias: true});
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
app.appendChild(renderer.domElement);
const labelRenderer = new CSS2DRenderer();
labelRenderer.domElement.style.cssText = 'position:absolute;inset:0;pointer-events:none';
app.appendChild(labelRenderer.domElement);

const scene = new THREE.Scene();
const bgColor = () => new THREE.Color(getComputedStyle(document.documentElement).getPropertyValue('--bg').trim() || '#e9e4da');
scene.background = bgColor();
matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { scene.background = bgColor(); });

const VIEW = 34;
const camera = new THREE.OrthographicCamera(-VIEW, VIEW, VIEW, -VIEW, 0.1, 400);
const HOME = {pos: new THREE.Vector3(39, 46, 45), target: new THREE.Vector3(9, 0, -1), zoom: 0.78};  // shifted right: the side panel covers the right edge
camera.position.copy(HOME.pos); camera.zoom = HOME.zoom; camera.updateProjectionMatrix();
const controls = new OrbitControls(camera, renderer.domElement);
controls.target.copy(HOME.target);
controls.enableDamping = true;
controls.screenSpacePanning = false;
controls.minZoom = 0.6; controls.maxZoom = 4;
controls.minPolarAngle = 0.35; controls.maxPolarAngle = 1.1;
controls.mouseButtons = {LEFT: THREE.MOUSE.PAN, MIDDLE: THREE.MOUSE.DOLLY, RIGHT: THREE.MOUSE.ROTATE};
controls.touches = {ONE: THREE.TOUCH.PAN, TWO: THREE.TOUCH.DOLLY_ROTATE};

scene.add(new THREE.HemisphereLight(0xfff8ee, 0x8a8170, 1.6));
const sun = new THREE.DirectionalLight(0xffffff, 1.6);
sun.position.set(-20, 40, 25);
sun.castShadow = true;
sun.shadow.mapSize.set(2048, 2048);
Object.assign(sun.shadow.camera, {left: -45, right: 45, top: 30, bottom: -30, near: 1, far: 120});
sun.shadow.bias = -0.0004;
scene.add(sun);

const mat = c => new THREE.MeshStandardMaterial({color: c, roughness: 0.85});
const toon = c => new THREE.MeshToonMaterial({color: c});
const OUTLINE = new THREE.MeshBasicMaterial({color: 0x1d2329, side: THREE.BackSide});
function box(w, h, d, m, x = 0, y = 0, z = 0, parent = scene) {
  const o = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), m);
  o.position.set(x, y, z); o.castShadow = o.receiveShadow = true; parent.add(o); return o;
}
function label(html, cls, parent, x, y, z) {
  const el = document.createElement('div'); el.className = cls; el.innerHTML = html;
  const o = new CSS2DObject(el); o.position.set(x, y, z); parent.add(o); return o;
}

// building floor and corridors
box(64, 0.4, 36, mat(0xb9b2a6), 0, -0.25, 0);
const pickables = [];
for (const r of ROOMS) {
  const g = new THREE.Group(); g.position.set(r.x, 0, r.z); scene.add(g); r.group = g;
  const floor = box(r.w, 0.1, r.d, mat(r.floor), 0, 0, 0, g);
  floor.userData = {type: 'room', id: r.id}; pickables.push(floor);
  const wall = mat(0xf4f1ea), H = 1.4, T = 0.3;
  box(r.w, H, T, wall, 0, H / 2, -r.d / 2, g);                     // back wall
  box(T, H, r.d, wall, -r.w / 2, H / 2, 0, g);                     // left wall
  box(T, H, r.d, wall, r.w / 2, H / 2, 0, g);                      // right wall
  box(r.w / 2 - 1.5, H * 0.45, T, wall, -r.w / 4 - 0.75, H * 0.22, r.d / 2, g);  // low front wall with a door gap
  box(r.w / 2 - 1.5, H * 0.45, T, wall, r.w / 4 + 0.75, H * 0.22, r.d / 2, g);
  r.lbl = label(esc(r.name), 'room-label', g, -r.w / 2 + 2.6, 1.6, -r.d / 2 + 0.6);
  // a plant in a corner and a shelf on the back wall
  box(0.7, 0.6, 0.7, mat(0x9b6b43), r.w / 2 - 1, 0.3, -r.d / 2 + 1, g);
  const leaf = new THREE.Mesh(new THREE.IcosahedronGeometry(0.75, 0), toon(0x5c9e5a)); leaf.position.set(r.w / 2 - 1, 1.15, -r.d / 2 + 1); leaf.castShadow = true; g.add(leaf);
  box(2.6, 1.6, 0.5, mat(0xc9a77c), -r.w / 2 + 2.2, 0.8, -r.d / 2 + 0.6, g);
  r.table = new THREE.Vector3(r.w / 2 - 2.6, 0, r.d / 2 - 2.4);     // where the video folders of this stage lie
  box(3.4, 0.9, 2, mat(0xe0d4bf), r.table.x, 0.45, r.table.z, g);
}

// ------------------------------------------------------------ staff: clothed stick figures at desks
function figure(color) {
  const g = new THREE.Group();
  const black = toon(0x1d2329);
  const legGeo = new THREE.CylinderGeometry(0.07, 0.07, 0.9, 6);
  for (const s of [-0.18, 0.18]) { const l = new THREE.Mesh(legGeo, black); l.position.set(s, 0.45, 0); g.add(l); }
  const body = new THREE.Mesh(new THREE.CylinderGeometry(0.42, 0.5, 1.0, 12), toon(color)); body.position.y = 1.35; body.castShadow = true; g.add(body);
  const bodyLine = new THREE.Mesh(body.geometry, OUTLINE); bodyLine.scale.setScalar(1.06); body.add(bodyLine);
  const arms = [];
  for (const s of [-1, 1]) {
    const pivot = new THREE.Group(); pivot.position.set(0.48 * s, 1.75, 0);
    const a = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 0.85, 6), black); a.position.y = -0.42; pivot.add(a);
    const hand = new THREE.Mesh(new THREE.SphereGeometry(0.13, 10, 8), toon(0xffffff)); hand.position.y = -0.86; pivot.add(hand);
    pivot.rotation.z = 0.25 * s; g.add(pivot); arms.push(pivot);
  }
  const head = new THREE.Mesh(new THREE.SphereGeometry(0.55, 20, 16), toon(0xffffff)); head.position.y = 2.45; head.castShadow = true; g.add(head);
  const headLine = new THREE.Mesh(head.geometry, OUTLINE); headLine.scale.setScalar(1.08); head.add(headLine);
  for (const s of [-0.17, 0.17]) { const e = new THREE.Mesh(new THREE.SphereGeometry(0.06, 8, 6), black); e.position.set(s, 0.08, 0.5); head.add(e); }
  const mouth = new THREE.Mesh(new THREE.TorusGeometry(0.12, 0.025, 6, 12, Math.PI), black); mouth.position.set(0, -0.12, 0.5); mouth.rotation.z = Math.PI; head.add(mouth);
  return {g, arms, head, body};
}

for (const s of STAFF) {
  const r = roomById[s.room];
  const g = new THREE.Group(); g.position.set(s.at[0], 0, s.at[1]); r.group.add(g); s.group = g;
  // desk in front (toward the camera), monitor facing the worker, chair behind
  box(2.4, 0.9, 1.2, mat(0xd8c3a0), 0, 0.45, 1.1, g);
  const monitor = box(1.3, 0.85, 0.12, mat(0x2b3138), 0, 1.35, 1.25, g);
  s.lamp = box(1.1, 0.12, 0.14, new THREE.MeshStandardMaterial({color: 0x555d66, emissive: 0x000000}), 0, 1.84, 1.25, g);
  box(1, 0.5, 1, mat(0x59616b), 0, 0.25, -0.55, g);
  const f = figure(COLORS[s.who]); f.g.position.set(0, 0, -0.15); g.add(f.g); s.fig = f;
  const ring = new THREE.Mesh(new THREE.RingGeometry(0.75, 0.95, 32), new THREE.MeshBasicMaterial({color: 0x9aa3ab, transparent: true, opacity: 0.8}));
  ring.rotation.x = -Math.PI / 2; ring.position.set(0, 0.07, -0.15); g.add(ring); s.ring = ring;
  s.nameTag = label(s.who === 'code' ? esc(s.name) : esc(s.name) + ' · ' + esc(s.role.split(':')[0]), 'name', g, 0, -0.1, 2.2);
  s.bubble = label('', 'bubble', g, 0, 3.6, -0.15); s.bubble.visible = false;
  for (const m of [f.body, f.head, monitor]) { m.userData = {type: 'staff', id: s.id}; pickables.push(m); }
  s.phase = Math.random() * 6;
}

// ------------------------------------------------------------ live data
let S = {state: null, ch: new URLSearchParams(location.search).get('ch') || localStorage.getItem('ch') || 'median-worker', sel: null, folders: []};
const now = () => Date.now() / 1000;
function staffJobs(s) {
  const jobs = (S.state?.jobs || []).filter(j => s.actions && (s.actions.includes(j.action) || (!j.action && s.actions.includes(j.kind))));
  return {running: jobs.filter(j => j.status === 'running'), recent: jobs.filter(j => j.status !== 'running')};
}
function workersOf(j) { const m = /--workers (\d+)/.exec(j.cmd || ''); return m ? +m[1] : (j.action === 'redo' ? 1 : 4); }
function current(s) {
  const {running, recent} = staffJobs(s);
  let j = running[0];
  if (j && s.painter && s.painter > workersOf(j)) j = null;  // a run with 2 workers keeps painters 3 and 4 idle
  const last = recent[0];
  const fresh = last && last.ended && now() - last.ended < (last.status === 'done' ? 25 : 180);
  return {job: j, last: fresh ? last : null};
}
function ownerTodo() {
  const c = (S.state?.channels || []).find(c => c.id === S.ch);
  return c ? c.list.filter(v => !v.published && /Bạn/i.test(v.next_who)) : [];
}

async function poll() {
  try {
    S.state = await (await fetch('/api/state')).json();
  } catch (e) { $('#run').textContent = 'Mất kết nối server'; setTimeout(poll, 4000); return; }
  const sel = $('#ch');
  if (sel.options.length !== S.state.channels.length) sel.innerHTML = S.state.channels.map(c => `<option value="${esc(c.id)}">${esc(c.name)}</option>`).join('');
  if (!S.state.channels.some(c => c.id === S.ch)) S.ch = S.state.channels[0].id;
  sel.value = S.ch;
  const running = S.state.jobs.filter(j => j.status === 'running');
  $('#run').innerHTML = running.length ? `<span class="dot" style="background:var(--warn)"></span>${running.length} việc đang chạy` : '<span class="muted">Không có việc nào đang chạy</span>';
  $('#feed').innerHTML = S.state.jobs.slice(0, 7).map(j => `<div><span class="chip ${esc(j.status)}">${esc(j.status)}</span>${esc(j.label)}</div>`).join('') || '<div class="muted">Chưa có việc nào.</div>';
  layoutFolders();
  if (!S.panelLocked) renderPanel();
  setTimeout(poll, running.length ? 1500 : 4000);
}
$('#ch').onchange = e => { S.ch = e.target.value; localStorage.setItem('ch', S.ch); S.sel = null; layoutFolders(); renderPanel(); };

// video folders lie on the table of the room for the step they need next
const folderGeo = new THREE.BoxGeometry(0.9, 0.12, 0.65);
let folderKey = '';
function layoutFolders() {
  const c = (S.state?.channels || []).find(c => c.id === S.ch);
  const key = c ? S.ch + JSON.stringify(c.list.map(v => [v.slug, v.next, v.next_who, v.published])) : '';
  if (key === folderKey) return;  // rebuild only when a video moved to another room
  folderKey = key;
  for (const f of S.folders) { f.mesh.remove(f.tag); f.mesh.parent.remove(f.mesh); f.mesh.material.dispose(); }  // removing the tag also removes its HTML
  S.folders = [];
  if (!c) return;
  const perRoom = {};
  for (const v of c.list.filter(v => !v.published)) {
    const r = roomById[ROOM_OF_STEP[v.next] || 'publish'];
    const k = perRoom[r.id] = (perRoom[r.id] || 0) + 1;
    const wait = /Bạn/i.test(v.next_who);
    const m = new THREE.Mesh(folderGeo, mat(wait ? 0xf3a58c : 0xf2cf6b));
    m.position.set(r.table.x - 1 + ((k - 1) % 3) * 1, 0.97 + Math.floor((k - 1) / 3) * 0.14, r.table.z);
    m.castShadow = true; m.userData = {type: 'video', slug: v.slug};
    r.group.add(m); pickables.push(m);
    const tag = label(`${wait ? '! ' : ''}Video ${esc(v.slug.slice(0, 3))}`, 'folder' + (wait ? ' wait' : ''), m, 0, 0.5, 0);
    S.folders.push({mesh: m, tag, v, room: r});
  }
  for (let i = pickables.length - 1; i >= 0; i--) if (pickables[i].userData.type === 'video' && !S.folders.some(f => f.mesh === pickables[i])) pickables.splice(i, 1);
}

// ------------------------------------------------------------ side panel
function openLink(v, step) { return `/#v/${encodeURIComponent(S.ch)}/${encodeURIComponent(v)}/${TAB_OF_STEP[step] || 'script'}`; }
function jobVideoLink(j) { if (!j.video) return ''; const [ch, slug] = j.video.split('/'); return `/#v/${encodeURIComponent(ch)}/${encodeURIComponent(slug)}/script`; }
async function renderPanel() {
  const p = $('#panel'), sel = S.sel;
  if (!S.state) return;
  if (!sel) {
    const todo = ownerTodo();
    p.innerHTML = `<h2>Toàn công ty</h2><div class="muted">Bấm vào một nhân viên, một phòng hoặc một tập hồ sơ video.</div>
      ${todo.length ? `<h3>Đang chờ bạn (${todo.length})</h3><ul class="list">${todo.map(v => `<li data-video="${esc(v.slug)}"><span class="folder wait">Video ${esc(v.slug.slice(0, 3))}</span><span>${esc(v.next_label)}</span></li>`).join('')}</ul>` : ''}
      <h3>Nhân sự</h3><ul class="list">${STAFF.map(s => { const c = current(s); return `<li data-staff="${s.id}"><i class="dot" style="background:var(--${s.who})"></i><span style="flex:1"><b>${esc(s.name)}</b> <span class="muted">${esc(s.role.split(':')[0])}</span></span>${c.job ? '<span class="chip running">đang làm</span>' : c.last ? `<span class="chip ${esc(c.last.status)}">${c.last.status === 'done' ? 'vừa xong' : 'lỗi'}</span>` : '<span class="chip">rảnh</span>'}</li>`; }).join('')}</ul>`;
  } else if (sel.type === 'staff') {
    const s = STAFF.find(x => x.id === sel.id), c = current(s), {recent} = staffJobs(s);
    const j = c.job;
    let log = '';
    if (j) { try { const r = await (await fetch('/api/job?id=' + j.id)).json(); log = r.text.split('\n').filter(l => l && !l.startsWith('$')).slice(-14).join('\n'); } catch (e) {} }
    if (S.sel !== sel) return;
    p.innerHTML = `<button id="back">← Toàn công ty</button>
      <h2 style="margin-top:10px"><i class="dot" style="background:var(--${s.who})"></i>${esc(s.name)}</h2><div class="muted">${esc(WHO[s.who])} · ${esc(roomById[s.room].name)}</div>
      <p>${esc(s.role)}</p>
      <h3>Việc hiện tại</h3>
      ${j ? `<div><b>${esc(j.label)}</b> <span class="chip running">${fmt(now() - j.started)}</span>${j.video ? `<div class="muted">Video: ${esc(j.video)}</div>` : ''}</div>
        <div class="row" style="margin-top:8px"><button data-stop="${esc(j.id)}">Dừng việc</button>${j.video ? `<a class="btn" href="${jobVideoLink(j)}">Mở video</a>` : ''}</div><pre>${esc(log || '…')}</pre>`
        : s.id === 'owner' ? ownerHtml() : '<div class="muted">Đang rảnh. Giao việc từ Bảng điều khiển.</div>'}
      <h3>Việc gần đây</h3><ul class="list">${recent.slice(0, 8).map(r => `<li><span class="chip ${esc(r.status)}">${esc(r.status)}</span><span>${esc(r.label)}</span></li>`).join('') || '<li class="muted">Chưa có.</li>'}</ul>`;
  } else if (sel.type === 'room') {
    const r = roomById[sel.id];
    const folders = S.folders.filter(f => f.room === r);
    p.innerHTML = `<button id="back">← Toàn công ty</button><h2 style="margin-top:10px">${esc(r.name)}</h2>
      <h3>Nhân viên</h3><ul class="list">${STAFF.filter(s => s.room === r.id).map(s => `<li data-staff="${s.id}"><i class="dot" style="background:var(--${s.who})"></i><span style="flex:1">${esc(s.name)} <span class="muted">${esc(s.role.split(':')[0])}</span></span>${current(s).job ? '<span class="chip running">đang làm</span>' : '<span class="chip">rảnh</span>'}</li>`).join('')}</ul>
      <h3>Hồ sơ video ở phòng này</h3><ul class="list">${folders.map(f => `<li data-video="${esc(f.v.slug)}"><span class="folder${/Bạn/i.test(f.v.next_who) ? ' wait' : ''}">Video ${esc(f.v.slug.slice(0, 3))}</span><span>${esc(f.v.title)}</span></li>`).join('') || '<li class="muted">Không có video nào.</li>'}</ul>`;
  } else if (sel.type === 'video') {
    const f = S.folders.find(f => f.v.slug === sel.slug);
    if (!f) { S.sel = null; return renderPanel(); }
    const v = f.v;
    p.innerHTML = `<button id="back">← Toàn công ty</button><h2 style="margin-top:10px">Video ${esc(v.slug.slice(0, 3))}</h2><div>${esc(v.title)}</div>
      <h3>Tiến độ</h3><div>${v.done_steps}/${v.total_steps} bước · đang ở ${esc(f.room.name)}</div>
      <div style="height:6px;border-radius:3px;background:rgba(127,127,127,.2);margin-top:6px;overflow:hidden"><div style="height:100%;width:${Math.round(100 * v.done_steps / v.total_steps)}%;background:var(--ok)"></div></div>
      <h3>Việc tiếp theo</h3><div><b>${esc(v.next_label)}</b> · người làm: ${esc(v.next_who)}</div>
      <div class="row" style="margin-top:10px"><a class="btn pri" href="${openLink(v.slug, v.next)}">Mở video trên Bảng điều khiển</a>${v.render ? `<a class="btn" href="/#v/${encodeURIComponent(S.ch)}/${encodeURIComponent(v.slug)}/preview">▶ Xem video</a>` : ''}</div>`;
  }
  p.querySelector('#back')?.addEventListener('click', () => select(null));
  p.querySelectorAll('[data-staff]').forEach(el => el.onclick = () => select({type: 'staff', id: el.dataset.staff}));
  p.querySelectorAll('[data-video]').forEach(el => el.onclick = () => select({type: 'video', slug: el.dataset.video}));
  p.querySelectorAll('[data-stop]').forEach(b => b.onclick = async () => { await fetch('/api/action', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({action: 'stop', job: b.dataset.stop})}); });
}
function ownerHtml() {
  const todo = ownerTodo();
  return todo.length ? `<div>${todo.length} video đang chờ bạn:</div><ul class="list">${todo.map(v => `<li data-video="${esc(v.slug)}"><span class="folder wait">Video ${esc(v.slug.slice(0, 3))}</span><span>${esc(v.next_label)}</span></li>`).join('')}</ul>` : '<div class="muted">Không có việc nào chờ bạn.</div>';
}

// ------------------------------------------------------------ selection and camera moves
let fly = null;
function flyTo(target, zoom) { fly = {from: controls.target.clone(), to: target.clone(), z0: camera.zoom, z1: zoom, t: 0}; }
function select(sel) {
  S.sel = sel;
  if (!sel) flyTo(HOME.target, HOME.zoom);
  else if (sel.type === 'room') { const r = roomById[sel.id]; flyTo(new THREE.Vector3(r.x, 0, r.z), r.w > 20 ? 1.7 : 2.3); }
  else if (sel.type === 'staff') { const s = STAFF.find(x => x.id === sel.id); const p = new THREE.Vector3(); s.group.getWorldPosition(p); flyTo(p, 3.2); }
  else if (sel.type === 'video') { const f = S.folders.find(f => f.v.slug === sel.slug); if (f) { const p = new THREE.Vector3(); f.mesh.getWorldPosition(p); flyTo(p, 3); } }
  renderPanel();
}
$('#home').onclick = () => select(null);
let showNames = true;
$('#labels').onclick = e => { showNames = !showNames; e.target.textContent = showNames ? 'Ẩn tên' : 'Hiện tên'; e.target.setAttribute('aria-pressed', showNames); };

const ray = new THREE.Raycaster(), mouse = new THREE.Vector2();
let down = null;
renderer.domElement.addEventListener('pointerdown', e => { down = [e.clientX, e.clientY]; });
renderer.domElement.addEventListener('pointerup', e => {
  if (!down || Math.hypot(e.clientX - down[0], e.clientY - down[1]) > 5) return;  // a drag pans, a click selects
  const rect = renderer.domElement.getBoundingClientRect();
  mouse.set((e.clientX - rect.left) / rect.width * 2 - 1, -(e.clientY - rect.top) / rect.height * 2 + 1);
  ray.setFromCamera(mouse, camera);
  const hit = ray.intersectObjects(pickables, false)[0];
  if (!hit) return;
  const u = hit.object.userData;
  select(u.type === 'staff' ? {type: 'staff', id: u.id} : u.type === 'video' ? {type: 'video', slug: u.slug} : {type: 'room', id: u.id});
});
renderer.domElement.addEventListener('pointermove', e => {
  const rect = renderer.domElement.getBoundingClientRect();
  mouse.set((e.clientX - rect.left) / rect.width * 2 - 1, -(e.clientY - rect.top) / rect.height * 2 + 1);
  ray.setFromCamera(mouse, camera);
  const hit = ray.intersectObjects(pickables, false)[0];
  renderer.domElement.style.cursor = hit && hit.object.userData.type !== 'room' ? 'pointer' : 'grab';
});

function resize() {
  const w = innerWidth, h = innerHeight, a = w / h;
  camera.left = -VIEW * a / 1.6; camera.right = VIEW * a / 1.6; camera.top = VIEW / 1.6; camera.bottom = -VIEW / 1.6;
  camera.updateProjectionMatrix();
  renderer.setSize(w, h); labelRenderer.setSize(w, h);
}
addEventListener('resize', resize); resize();

// ------------------------------------------------------------ animation: who is working shows it
const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
const clock = new THREE.Clock();
const LAMP = {run: 0xf2a43a, done: 0x3fbf7f, bad: 0xe0524f, idle: 0x000000};
function tick() {
  const dt = clock.getDelta(), t = clock.elapsedTime;
  if (fly) {
    fly.t = Math.min(1, fly.t + dt * 1.8); const k = 1 - Math.pow(1 - fly.t, 3);
    const nt = fly.from.clone().lerp(fly.to, k), shift = nt.clone().sub(controls.target);
    controls.target.add(shift); camera.position.add(shift);
    camera.zoom = fly.z0 + (fly.z1 - fly.z0) * k; camera.updateProjectionMatrix();
    if (fly.t >= 1) fly = null;
  }
  for (const s of STAFF) {
    const c = current(s), f = s.fig;
    let state = c.job ? 'run' : c.last ? (c.last.status === 'done' ? 'done' : 'bad') : 'idle';
    if (s.id === 'owner' && !c.job && ownerTodo().length) state = 'wait';
    const typing = state === 'run' && !reduced;
    f.arms[0].rotation.x = typing ? -0.9 + Math.sin(t * 14 + s.phase) * 0.25 : -0.15;
    f.arms[1].rotation.x = typing ? -0.9 + Math.sin(t * 14 + s.phase + 1.6) * 0.25 : -0.15;
    f.head.position.y = 2.45 + (reduced ? 0 : Math.sin(t * (typing ? 6 : 1.5) + s.phase) * (typing ? 0.04 : 0.025));
    s.lamp.material.emissive.setHex(state === 'wait' ? LAMP.bad : (LAMP[state] ?? 0));
    s.lamp.material.emissiveIntensity = state === 'run' ? 0.8 + Math.sin(t * 5) * 0.4 : 1;
    s.ring.material.color.setHex(state === 'run' ? 0xf2a43a : state === 'done' ? 0x3fbf7f : state === 'bad' || state === 'wait' ? 0xe0524f : 0x9aa3ab);
    const el = s.bubble.element;
    if (state === 'run') { el.className = 'bubble run'; el.innerHTML = `${esc(c.job.label)}<span class="t">${fmt(now() - c.job.started)}</span>`; }
    else if (state === 'done') { el.className = 'bubble done'; el.textContent = '✓ Xong: ' + c.last.label; }
    else if (state === 'bad') { el.className = 'bubble bad'; el.textContent = (c.last.status === 'stopped' ? 'Đã dừng: ' : 'Lỗi: ') + c.last.label; }
    else if (state === 'wait') { const n = ownerTodo().length; el.className = 'bubble bad'; el.textContent = `${n} video chờ bạn`; }
    s.bubble.visible = state !== 'idle';
    s.nameTag.visible = showNames;
  }
  for (const r of ROOMS) r.lbl.visible = showNames || camera.zoom < 1.4;
  controls.update();
  renderer.render(scene, camera);
  labelRenderer.render(scene, camera);
  requestAnimationFrame(tick);
}
poll();
renderPanel();
tick();
</script>
</body>
</html>
