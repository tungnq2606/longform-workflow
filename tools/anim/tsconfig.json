{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types"],
    "paths": {"@kit": ["src/kit/index.ts"], "remotion": ["node_modules/remotion"], "react": ["node_modules/@types/react"]}
  },
  "include": ["src", "../../videos/*/anim/*.tsx"]
}
